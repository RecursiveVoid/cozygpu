# Node modules
node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
jspm_packages/
.pnpm-store/

# Output directories (commonly used by Rollup)
dist/
build/


# Temporary build files
*.tmp
*.cache
.cache/

# Rollup cache
.rollup.cache/

# Mac system files
.DS_Store

# VSCode settings (optional)
.vscode/

# Environment variables
.env
.env.local
.env.*.local

# IDE specific files
.idea/
*.sublime-project
*.sublime-workspace

# Operating system generated files
Thumbs.db
Desktop.ini

# npm package-lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Coverage files
coverage/

# Example screenshots from headless checks
examples/_screenshots/

# scripts/size.mjs scratch outdir (esbuild write:false, but the path is named)
.size-out/

# Local tooling / assistant files (never published)
CLAUDE.md
CLAUDE.local.md
.claude/
AGENTS.md
.cursor/
.cursorrules

# Internal planning docs (kept locally, not published)
docs/reports/
ROADMAP.md

# Benchmark scratch runs: only final results are published
benchmarks/results/*
!benchmarks/results/*-final.json
!benchmarks/results/*-final.md
!benchmarks/results/latest.md
