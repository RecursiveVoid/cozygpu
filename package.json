{
  "name": "cozygpu",
  "author": "Ergin Turk",
  "version": "0.0.1",
  "description": "Lightweight WebGPU-first 2D graphics library: Pixi-like scene graph plus GPU-simulated Swarms of millions of objects.",
  "type": "module",
  "main": "dist/cozygpu.cjs",
  "module": "dist/cozygpu.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cozygpu.js",
      "require": "./dist/cozygpu.cjs"
    },
    "./worker": "./dist/cozygpu.worker.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/cozygpu.worker.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prettier": "prettier --write 'src/**/*.{ts,js,json,css,md}' 'examples/**/*.{ts,html}' 'site/**/*.{ts,html,css}' '.github/**/*.yml' 'docs/**/*.md' 'scripts/**/*.{mjs,cjs}' 'benchmarks/**/*.{ts,mjs,js}' 'rollup.config.cjs' 'jest.config.cjs' '*.md'",
    "prettier:check": "prettier --check 'src/**/*.{ts,js,json,css,md}' 'examples/**/*.{ts,html}' 'site/**/*.{ts,html,css}' '.github/**/*.yml' 'docs/**/*.md' 'scripts/**/*.{mjs,cjs}' 'benchmarks/**/*.{ts,mjs,js}' 'rollup.config.cjs' 'jest.config.cjs' '*.md'",
    "build": "rollup -c rollup.config.cjs",
    "size": "node scripts/size.mjs",
    "size:baseline": "node scripts/size.mjs --update-baseline",
    "check:sources": "node scripts/check-sources.mjs",
    "build:examples": "EXAMPLES=1 rollup -c rollup.config.cjs",
    "build:site": "SITE=1 rollup -c rollup.config.cjs",
    "dev": "rollup -c rollup.config.cjs --watch",
    "prepublishOnly": "npm run check:sources && npm run prettier:check && npm run typecheck && npm test && npm run build && npm run size"
  },
  "keywords": [
    "webgpu",
    "webgl2",
    "2d",
    "graphics",
    "sprites",
    "particles",
    "compute",
    "renderer"
  ],
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/jest": "^29.5.13",
    "@types/three": "0.186.0",
    "@webgpu/types": "^0.1.46",
    "esbuild": "0.28.2",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "msw": "^2.4.9",
    "nodemon": "^3.1.7",
    "pixi.js": "8.20.1",
    "prettier": "^3.3.3",
    "puppeteer-core": "25.11.0",
    "rollup": "^4.22.5",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^1.1.1",
    "rollup-plugin-string": "^3.0.0",
    "three": "0.186.0",
    "ts-jest": "^29.2.5",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  }
}
